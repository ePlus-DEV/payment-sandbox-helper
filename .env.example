# Payment Sandbox Helper environment example
#
# Copy this file to .env for local WXT store submission:
#   cp .env.example .env
#
# Never commit real credentials.

# ---------------------------------------------------------------------------
# GitHub Actions bot automation
# ---------------------------------------------------------------------------
# Used by:
# - pr-auto-assign.yml
# - pr-auto-approve.yml
# - eplus-bot-review-command.yml
# - dependabot-auto-merge.yml
#
# In GitHub, configure this as an Actions repository secret instead of relying
# on the local .env file:
# Settings -> Secrets and variables -> Actions -> Repository secrets
EPLUS_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Chrome Web Store
# ---------------------------------------------------------------------------
CHROME_EXTENSION_ID=
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=

# Optional WXT submission settings.
CHROME_PUBLISH_TARGET="default"
CHROME_SKIP_SUBMIT_REVIEW=false

# ---------------------------------------------------------------------------
# Firefox Add-ons
# ---------------------------------------------------------------------------
FIREFOX_EXTENSION_ID=
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=

# Optional WXT submission setting.
FIREFOX_CHANNEL="listed"
